---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const trainingSlides = [
  {
    year: "2026",
    title: "2026 AI Training Slides",
    href: "/slides/2026-ai-training.pdf",
    participants: "210 participants",
    size: "5.4 MB",
  },
  {
    year: "2025",
    title: "2025 AI Training Slides",
    href: "/slides/2025-ai-training.pdf",
    participants: "140 participants",
    size: "5.5 MB",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <p>Hi 👋 , this is Waylon.</p>
      <p class="mt-2">
        I’m documenting my ideas and learning notes in this blog.
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={["pt-12 pb-6", "border-b border-border"]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured Writing</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section
      id="training-slides"
      class:list={["pt-12 pb-6", "border-b border-border"]}
    >
      <h2 class="text-2xl font-semibold tracking-wide">AI Training Slides</h2>
      <p class="mt-2">Slides from recent AI training sessions.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          trainingSlides.map(slide => (
            <li>
              <a
                href={slide.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "group block h-full border border-border bg-muted/20 p-4 transition-colors",
                  "hover:border-accent hover:bg-muted/40 focus-visible:no-underline",
                ]}
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-sm text-foreground/70">{slide.year}</p>
                    <h3 class="mt-1 text-lg font-medium text-accent">
                      {slide.title}
                    </h3>
                  </div>
                  <span class="border border-border px-2 py-1 text-xs">
                    PDF · {slide.size}
                  </span>
                </div>
                <p class="mt-4 text-sm">{slide.participants}</p>
                <p class="mt-3 inline-flex items-center gap-1 text-sm text-accent">
                  View slides
                  <span class="sr-only"> (opens in a new tab)</span>
                  <IconArrowRight class="size-4 transition-transform group-hover:translate-x-1 rtl:-rotate-180" />
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        Browse All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
